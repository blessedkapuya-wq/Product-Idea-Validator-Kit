# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ACCESS_KEY_SECRET: Server-only secret (>= 32 random chars) used to sign & verify
# individually issued Paid Member Access Keys (HMAC-SHA256).
# Never expose to the browser. Verification fails closed if unset or < 32 chars.
ACCESS_KEY_SECRET="REPLACE_WITH_64_HEX_CHAR_SERVER_SECRET"

# SESSION_SECRET: Server-only secret (>= 32 random chars) used to sign & verify
# HttpOnly Secure SameSite session cookies. Fails closed if unset or < 32 chars.
SESSION_SECRET="REPLACE_WITH_64_HEX_CHAR_SESSION_SECRET"

# SELAR_CHECKOUT_URL: Server-configured Selar checkout link (TSh 15,000 / USD $7).
# Purchase CTAs remain disabled until a valid https://selar.co/... or https://selar.com/... URL is set.
SELAR_CHECKOUT_URL=""

# REVOKED_KEY_IDS: Optional comma-separated list of key IDs to revoke access (e.g. "k_abc123,k_def456").
REVOKED_KEY_IDS=""
