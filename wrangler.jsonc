{
  "name": "product-idea-validator-kit",
  "main": "worker.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "build": {
    "command": "node scripts/build-worker-assets.mjs"
  },
  "vars": {
    "SELAR_CHECKOUT_URL": "https://selar.com/17tgm219sm"
  }
}
